{
  "name": "opencode-jev",
  "version": "0.2.0",
  "description": "Automatic JEV evaluation and code refinement for OpenCode",
  "type": "module",
  "license": "MIT",
  "exports": "./index.ts",
  "files": [
    "index.ts",
    "opencode-jev/plugin.ts",
    "opencode-jev/io.ts",
    "opencode-jev/harness.ts",
    "opencode-jev/workspace.ts",
    "jev_evaluate.py",
    "opencode_jev_bridge.py",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "python3 -B -m unittest test_jev_evaluate test_opencode_jev_bridge && node --test opencode-jev/*.test.ts",
    "test:smoke": "python3 -B opencode-jev/smoke.py",
    "typecheck": "tsc"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "evaluator-optimizer"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
